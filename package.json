{
  "name": "fudaner",
  "version": "0.1.0",
  "private": true,
  "description": "Fudaner：懂复旦的 AI 私人助理（学生自制，非官方产品）",
  "author": "Fudaner Team",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "dev:demo": "cross-env FUDANER_DEMO=1 electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "archive-codec": "1.11.27",
    "bmp-js": "0.1.0",
    "cheerio": "1.1.2",
    "heic-decode": "2.1.0",
    "imapflow": "1.7.8",
    "jszip": "3.10.2",
    "mailparser": "3.14.1",
    "mammoth": "1.13.0",
    "openai": "6.49.0",
    "pdf-parse": "1.1.4",
    "ppt-codec": "2.2.24",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sax": "1.6.1",
    "sharp": "0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fudaner/fudan-auth": "*",
    "@fudaner/mcp-fudan-courses": "*",
    "@fudaner/mcp-fudan-elearning": "*",
    "@fudaner/mcp-fudan-mail": "*",
    "@types/bmp-js": "0.1.2",
    "@types/heic-decode": "2.0.1",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.5",
    "@types/pdf-parse": "1.1.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/sax": "1.2.7",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "5.2.0",
    "cross-env": "10.1.0",
    "electron": "38.8.6",
    "electron-builder": "26.18.1",
    "electron-vite": "4.0.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
